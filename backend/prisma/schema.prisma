  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model TenantUsageMonthly {
  tenantId           String   @db.UniqueIdentifier
  period             String   @db.NVarChar(191)
  messagesReserved   Int      @default(0)
  messagesSent       Int      @default(0)
  messagesFailed     Int      @default(0)
  mediaBytesUploaded BigInt   @default(0)
