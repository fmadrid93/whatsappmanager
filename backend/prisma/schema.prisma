  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy  AppUser           @relation("WebhookEndpointCreator", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveries WebhookDelivery[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model WebhookDelivery {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  tenantId       String    @db.UniqueIdentifier
  webhookId      String    @db.UniqueIdentifier
  eventType      String    @db.NVarChar(191)
  aggregateType  String?   @db.NVarChar(191)
  aggregateId    String?   @db.NVarChar(191)
  payload        Bytes
  status         String    @default("PENDING") @db.NVarChar(32)
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(5)
  availableAt    DateTime  @default(now())
  processingAt   DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  responseStatus Int?
  responseBody   String?   @db.NVarChar(2000)
  lastError      String?   @db.NVarChar(2000)
  lockedBy       String?   @db.NVarChar(191)
  lockExpiresAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  webhook WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, availableAt])
  @@index([tenantId, createdAt])
  @@index([webhookId, createdAt])
}

model IntegrationRequestLog {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId       String   @db.UniqueIdentifier
  apiKeyId       String?  @db.UniqueIdentifier
  endpoint       String   @db.NVarChar(500)
  method         String   @db.NVarChar(16)
  statusCode     Int
  durationMs     Int
  requestId      String?  @db.NVarChar(191)
  idempotencyKey String?  @db.NVarChar(191)
  remoteIp       String?  @db.NVarChar(191)
  errorMessage   String?  @db.NVarChar(2000)
  createdAt      DateTime @default(now())

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  apiKey IntegrationApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([statusCode, createdAt])
}

model ExternalConnector {
  id                     String    @id @default(uuid()) @db.UniqueIdentifier
  tenantId               String    @db.UniqueIdentifier
  createdByUserId        String    @db.UniqueIdentifier
  name                   String    @db.NVarChar(191)
  purpose                String    @default("GENERAL") @db.NVarChar(32)
  method                 String    @default("GET") @db.NVarChar(16)
  urlTemplate            String    @db.NVarChar(1000)
  headersPayload         Bytes
  bodyTemplate           String?   @db.NVarChar(Max)
  authType               String    @default("NONE") @db.NVarChar(32)
  authName               String?   @db.NVarChar(191)
  secretPayload          Bytes?
  timeoutMs              Int       @default(10000)
  itemsPath              String?   @db.NVarChar(500)
  phonePath              String?   @db.NVarChar(500)
  namePath               String?   @db.NVarChar(500)
  contactMappingsPayload Bytes
  status                 String    @default("ACTIVE") @db.NVarChar(32)
  lastSuccessAt          DateTime?
  lastFailureAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant             Tenant                       @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy          AppUser                      @relation("ExternalConnectorCreator", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  executions         ExternalConnectorExecution[]
  recurringCampaigns RecurringCampaign[]

  @@unique([tenantId, name])
  @@index([tenantId, purpose, status])
  @@index([createdByUserId])
}

model ExternalConnectorExecution {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId        String   @db.UniqueIdentifier
  connectorId     String   @db.UniqueIdentifier
  contextType     String   @db.NVarChar(32)
  contextId       String?  @db.NVarChar(191)
  outcome         String   @db.NVarChar(32)
  method          String   @db.NVarChar(16)
  requestUrl      String   @db.NVarChar(1000)
  responseStatus  Int?
  durationMs      Int
  mappedCount     Int      @default(0)
  responsePreview String?  @db.NVarChar(2000)
  errorMessage    String?  @db.NVarChar(2000)
  createdAt       DateTime @default(now())

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  connector ExternalConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, createdAt])
  @@index([connectorId, createdAt])
  @@index([outcome, createdAt])
}

// Campaña recurrente: cada intervalMinutes, el worker consulta al conector
// (ExternalConnector con purpose=CONTACT_SOURCE) por contactos, descarta los
// que ya fueron encolados/enviados alguna vez en este tenant (MessageQueue),
// y crea + arranca una Campaign normal de una sola vez con los restantes.
model RecurringCampaign {
  id                        String    @id @default(uuid()) @db.UniqueIdentifier
  tenantId                  String    @db.UniqueIdentifier
  createdByUserId           String    @db.UniqueIdentifier
  connectorId               String    @db.UniqueIdentifier
  mediaAssetId              String?   @db.UniqueIdentifier
  name                      String    @db.NVarChar(191)
  connectorVariablesPayload Bytes
  sessionIdsPayload         Bytes
  messagePayload            Bytes
  defaultRegion             String    @db.NVarChar(2)
  intervalMinutes           Int       @default(60)
  status                    String    @default("ACTIVE") @db.NVarChar(32)
  lastRunAt                 DateTime?
  lastRunOutcome            String?   @db.NVarChar(32)
  lastRunContactsFound      Int?
  lastRunContactsNew        Int?
  lastRunError              String?   @db.NVarChar(2000)
  lastCampaignId            String?   @db.UniqueIdentifier
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy  AppUser           @relation("RecurringCampaignCreator", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  connector  ExternalConnector @relation(fields: [connectorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mediaAsset MediaAsset?       @relation(fields: [mediaAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, status])
  @@index([status, lastRunAt])
}

model RateLimitBucket {
  key       String   @id @db.NVarChar(191)
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model TenantCapacityPolicy {
