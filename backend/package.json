{
  "name": "whatsapp-saas-backend",
  "version": "1.3.0-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "prisma:select": "node scripts/select-prisma-provider.mjs",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "test": "node scripts/run-tests.mjs all",
    "lock": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "migration:status": "prisma migrate status",
    "migration:validate": "prisma migrate status",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:contract": "node scripts/run-tests.mjs contract",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:coverage": "node scripts/run-tests.mjs all --coverage",
    "test:external": "node scripts/run-tests.mjs integration",
    "migration:validate-chain": "python scripts/validate-migration-chain.py",
    "syntax:validate": "node scripts/validate-typescript-syntax.mjs",
    "lock:validate": "python ../scripts/tests/validate-lockfiles.py --require",
    "prisma:baseline:sqlserver": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "prisma:dbpush": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@hapi/boom": "10.0.1",
    "@prisma/client": "6.19.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "express": "5.1.0",
    "google-libphonenumber": "3.2.40",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "pino": "9.9.0",
    "pino-pretty": "13.1.1",
    "qrcode": "1.5.4",
    "redis": "^4.7.0",
    "zod": "4.1.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/google-libphonenumber": "7.4.30",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.5",
    "prisma": "6.19.0",
    "tsx": "4.20.0",
    "typescript": "5.9.3"
  }
}
