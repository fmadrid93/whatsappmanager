# WhatsApp SaaS v1.3.0-alpha - Windows Native SQL Server Edition
NODE_ENV=development
DEPLOYMENT_ENV=windows-local
APP_VERSION=1.3.0-alpha
BUILD_COMMIT=local
DOMAIN=localhost
API_PORT=3000
LOG_LEVEL=info
METRICS_PORT=9464
# METRICS_TOKEN=

# Microsoft SQL Server instalado nativamente en Windows
# Para instancia predeterminada: SQLSERVER_INSTANCE vacío y puerto 1433.
# Para SQL Express: SQLSERVER_INSTANCE=SQLEXPRESS y SQLSERVER_PORT vacío.
SQLSERVER_HOST=localhost
SQLSERVER_INSTANCE=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=whatsapp_saas
SQLSERVER_APP_USER=whatsapp_app
SQLSERVER_APP_PASSWORD=CambiarDb123!
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_SCHEMA=dbo
DATABASE_URL=sqlserver://localhost:1433;database=whatsapp_saas;user=whatsapp_app;password=CambiarDb123%21;encrypt=true;trustServerCertificate=true;schema=dbo
PRISMA_PROVIDER=sqlserver

# Seguridad: configure-environment.ps1 genera valores seguros
JWT_SECRET=CAMBIAR_CON_UNA_CLAVE_DE_48_CARACTERES_O_MAS
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=waas_refresh
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost
TRUST_PROXY=1
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MS=60000
ENCRYPTION_KEY_BASE64=CAMBIAR_BASE64_32_BYTES
# Integración externa opcional (mínimo 24 caracteres)
# INTEGRATION_API_KEY=
INTEGRATION_ADMIN_EMAIL=admin@demo.local

# Usuario inicial
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=Cambiar123!
SEED_TENANT_NAME=Empresa Demo

# Use MOCK para la primera prueba y BAILEYS/S3 para integración real
WHATSAPP_GATEWAY_MODE=MOCK
OBJECT_STORAGE_MODE=MOCK

# Worker
WORKER_ID=windows-worker-1
SESSION_LEASE_SECONDS=30
SESSION_SUPERVISOR_INTERVAL_MS=5000
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_LOCK_SECONDS=60
MESSAGE_RECONCILIATION_GRACE_MS=90000
MESSAGE_RECONCILIATION_INTERVAL_MS=15000
SEND_DELAY_MIN_MS=2500
SEND_DELAY_MAX_MS=5000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RETRY_MINUTES=30
DEFAULT_COUNTRY_REGION=BO
DEFAULT_AUTO_REPLY=Gracias por escribirnos. Un agente te responderá en breve.

# Escalabilidad inicial en Windows: SQL Server + memoria local
WORKER_SHARD_MODE=AUTO
WORKER_SHARD_ID=0
WORKER_SHARD_COUNT=1
WORKER_NODE_HEARTBEAT_MS=10000
WORKER_NODE_LEASE_SECONDS=30
EVENT_TRANSPORT=LOCAL
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LOCK_SECONDS=60
COORDINATION_PROVIDER=MEMORY
REDIS_KEY_PREFIX=waas
GLOBAL_MAX_PENDING_MESSAGES=500000
DEFAULT_MAX_SESSIONS=5
DEFAULT_MAX_CONCURRENT_CAMPAIGNS=3
DEFAULT_MAX_CAMPAIGN_CONTACTS=50000
DEFAULT_MAX_PENDING_MESSAGES=100000
DEFAULT_MONTHLY_MESSAGE_LIMIT=1000000

# AWS S3 real: complete al pasar a modo Real
AWS_REGION=sa-east-1
S3_BUCKET=mock-local-bucket
AWS_ACCESS_KEY_ID=reemplazar-access-key
AWS_SECRET_ACCESS_KEY=reemplazar-secret-key
# AWS_SESSION_TOKEN=
# S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_SECONDS=900
MEDIA_UPLOAD_URL_SECONDS=900
MAX_MEDIA_BYTES=26214400
READINESS_REQUIRE_S3=false
ENABLE_LEGACY_MEDIA_UPLOAD=true
SHUTDOWN_TIMEOUT_MS=120000

PUBLIC_APP_NAME=WhatsApp SaaS

# Automatic failover for technical failures only
AUTO_FAILOVER_ENABLED=true
AUTO_FAILOVER_WAIT_SECONDS=30
AUTO_FAILOVER_MAX_TARGETS=3
# Fatal errors (401/403/429, blocked or logged out) are quarantined and not transferred automatically
SESSION_QUARANTINE_MINUTES=1440
